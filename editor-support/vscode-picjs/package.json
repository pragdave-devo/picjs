{
  "name": "picjs",
  "displayName": "picjs",
  "description": "Syntax highlighting for picjs diagram language",
  "version": "0.1.0",
  "publisher": "picjs",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "picjs",
        "aliases": ["picjs", "pikchr"],
        "extensions": [".picjs", ".pikchr"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "picjs",
        "scopeName": "source.picjs",
        "path": "./syntaxes/picjs.tmLanguage.json"
      }
    ]
  }
}
