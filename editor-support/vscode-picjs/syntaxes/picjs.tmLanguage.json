{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "picjs",
  "scopeName": "source.picjs",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#control" },
    { "include": "#shapes" },
    { "include": "#directions" },
    { "include": "#attributes" },
    { "include": "#position-keywords" },
    { "include": "#references" },
    { "include": "#colors" },
    { "include": "#builtins" },
    { "include": "#labels" },
    { "include": "#variables" },
    { "include": "#operators" },
    { "include": "#edgepoints" },
    { "include": "#properties" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.hash.picjs",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.picjs",
          "match": "//.*$"
        },
        {
          "name": "comment.block.picjs",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.picjs",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.picjs",
              "match": "\\\\."
            },
            {
              "name": "variable.interpolation.picjs",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                { "include": "#numbers" },
                { "include": "#variables" },
                { "include": "#properties" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.picjs",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.with-unit.picjs",
          "match": "\\b\\d+(\\.\\d*)?\\s*(in|cm|mm|pt|px|pc|%)\\b"
        },
        {
          "name": "constant.numeric.float.picjs",
          "match": "\\b\\d+\\.\\d*\\b"
        },
        {
          "name": "constant.numeric.float.picjs",
          "match": "\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.picjs",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.picjs",
          "match": "\\$(pi|2pi)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.picjs",
          "match": "\\b(abs|cos|sin|sqrt|int|max|min|dist|d2r|r2d|rgb|hsl|oklch)\\s*(?=\\()"
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.picjs",
          "match": "\\b(define|for|in|do|step|print|assert)\\b"
        }
      ]
    },
    "shapes": {
      "patterns": [
        {
          "name": "keyword.other.shape.picjs",
          "match": "\\b(box|circle|ellipse|oval|cylinder|diamond|file|dot|text|line|arrow|spline|arc|move)\\b"
        }
      ]
    },
    "directions": {
      "patterns": [
        {
          "name": "keyword.other.direction.picjs",
          "match": "\\b(right|down|left|up|north|south|east|west)\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "storage.type.picjs",
          "match": "\\b(width|wid|height|ht|radius|rad|diameter|thickness)\\b"
        },
        {
          "name": "storage.type.picjs",
          "match": "\\b(color|fill|dashed|dotted|solid|thick|thin|invis|invisible)\\b"
        },
        {
          "name": "storage.type.picjs",
          "match": "\\b(fit|same|behind|chop|cw|ccw)\\b"
        },
        {
          "name": "storage.type.picjs",
          "match": "\\b(ljust|rjust|aligned|bold|italic|mono|monospace|big|small)\\b"
        }
      ]
    },
    "position-keywords": {
      "patterns": [
        {
          "name": "keyword.other.position.picjs",
          "match": "\\b(at|from|to|with|of|the|then|go|close)\\b"
        },
        {
          "name": "keyword.other.position.picjs",
          "match": "\\b(above|below|center|top|bottom|start|end|between|way|heading|even|until)\\b"
        }
      ]
    },
    "references": {
      "patterns": [
        {
          "name": "variable.language.picjs",
          "match": "\\b(last|first|previous|this)\\b"
        },
        {
          "name": "constant.numeric.ordinal.picjs",
          "match": "\\b\\d+(st|nd|rd|th)\\b"
        }
      ]
    },
    "colors": {
      "patterns": [
        {
          "name": "support.constant.color.picjs",
          "match": "\\b(red|green|blue|yellow|cyan|magenta|black|white|gray|grey|orange|pink|purple|brown|lime|navy|teal|maroon|olive|aqua|fuchsia|silver)\\b"
        },
        {
          "name": "support.constant.color.picjs",
          "match": "\\b(lightblue|lightgreen|lightgray|lightgrey|darkblue|darkgreen|darkgray|darkgrey|darkred)\\b"
        },
        {
          "name": "support.constant.color.picjs",
          "match": "\\b(None|Off)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "variable.other.builtin.picjs",
          "match": "\\b(arcrad|arrowhead|arrowht|arrowwid|boxht|boxrad|boxwid|charht|charwid|circlerad|cylht|cylrad|cylwid|dashwid|diamondht|diamondwid|dotrad|ellipseht|ellipsewid|fileht|filerad|filewid|fontscale|lineht|linewid|movewid|ovalht|ovalwid|scale|textht|textwid|thickness)\\b"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.tag.picjs",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\s*:"
        },
        {
          "name": "entity.name.class.picjs",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.picjs",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "variable.other.picjs",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.picjs",
          "match": "<->|<-|->"
        },
        {
          "name": "keyword.operator.assignment.picjs",
          "match": "\\+=|-=|\\*=|/=|="
        },
        {
          "name": "keyword.operator.arithmetic.picjs",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.comparison.picjs",
          "match": "==|<|>"
        }
      ]
    },
    "edgepoints": {
      "patterns": [
        {
          "name": "variable.other.property.picjs",
          "match": "\\.(n|ne|e|se|s|sw|w|nw|c|center|north|south|east|west|top|bot|bottom|left|right|start|end)\\b"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "variable.other.property.picjs",
          "match": "\\.(x|y|wid|width|ht|height|rad|radius|diameter|thickness|color|fill|dashed|dotted)\\b"
        }
      ]
    }
  }
}
