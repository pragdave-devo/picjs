{
  "name": "@strike48/picjs",
  "version": "0.2.0",
  "description": "Constraint-based diagram and animation package. Think Mermaid, but with layout",
  "main": "dist/picjs.js",
  "type": "module",
  "bin": {
    "picjs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/picjs.js",
      "types": "./dist/index.d.ts"
    },
    "./lume": {
      "import": "./dist/integrations/lume.js",
      "types": "./dist/integrations/lume.d.ts"
    },
    "./server": {
      "import": "./dist/render-to-string.js",
      "types": "./dist/render-to-string.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "types": "./dist/runtime.d.ts"
    }
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:runtime && npm run build:cli",
    "build:lib": "BUILD_TARGET=main vite build",
    "build:runtime": "BUILD_TARGET=runtime vite build",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --external:commander",
    "dev": "vite",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "parser": "make src/peg_parser/jp.js"
  },
  "repository": "https://github.com/pragdave-devo/picjs",
  "author": "pragdave",
  "license": "MIT",
  "browserslist": [
    "last 3 and_chr versions",
    "last 3 chrome versions",
    "last 3 opera versions",
    "last 3 ios_saf versions",
    "last 3 safari versions"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/register": "^7.28.6",
    "@types/culori": "^4.0.1",
    "@types/jest": "^29.5.14",
    "esbuild": "^0.27.7",
    "jest": "^29.7.0",
    "peggy": "^4.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.2"
  },
  "dependencies": {
    "@codemirror/theme-one-dark": "^6.1.3",
    "@datastructures-js/priority-queue": "^5.4.1",
    "codemirror": "^6.0.2",
    "commander": "^14.0.3",
    "culori": "^4.0.2",
    "redom": "^3.29.1",
    "simple-markdown": "^0.7.3"
  }
}
