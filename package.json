{
  "name": "@strike48/picjs",
  "version": "0.2.6",
  "description": "A language for creating animated, constraint-based SVG diagrams",
  "main": "dist/picjs.js",
  "type": "module",
  "bin": {
    "picjs": "./dist/cli.js"
  },
  "files": [
    "dist/picjs.js",
    "dist/picjs.umd.js",
    "dist/runtime.js",
    "dist/picjs.runtime.umd.js",
    "dist/cli.js",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/picjs.js",
      "default": "./dist/picjs.js"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    }
  },
  "keywords": [
    "diagram",
    "svg",
    "animation",
    "drawing",
    "visualization",
    "constraint",
    "layout",
    "flowchart",
    "architecture"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:runtime && npm run build:playground && npm run build:cli",
    "build:lib": "BUILD_TARGET=main vite build",
    "build:runtime": "BUILD_TARGET=runtime vite build",
    "build:playground": "BUILD_TARGET=playground vite build",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --external:commander",
    "dev": "vite",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:e2e": "npx playwright test",
    "parser": "make src/peg_parser/jp.js"
  },
  "repository": "https://github.com/pragdave-devo/picjs",
  "author": "pragdave",
  "license": "MIT",
  "browserslist": [
    "last 3 and_chr versions",
    "last 3 chrome versions",
    "last 3 opera versions",
    "last 3 ios_saf versions",
    "last 3 safari versions"
  ],
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@babel/core": "^7.29.0",
    "@babel/register": "^7.28.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@playwright/test": "^1.59.1",
    "@types/culori": "^4.0.1",
    "@types/jest": "^29.5.14",
    "codemirror": "^6.0.2",
    "esbuild": "^0.27.7",
    "jest": "^29.7.0",
    "peggy": "^4.2.0",
    "redom": "^3.29.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.2"
  },
  "dependencies": {
    "@datastructures-js/priority-queue": "^5.4.1",
    "commander": "^14.0.3",
    "culori": "^4.0.2",
    "simple-markdown": "^0.7.3"
  }
}
