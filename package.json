{
  "name": "@strike48/picjs",
  "version": "0.1.6",
  "description": "Native TypeScript implementation of PIC-like diagram language to SVG",
  "type": "module",
  "main": "./dist/picjs.umd.js",
  "module": "./dist/picjs.js",
  "types": "./dist/picjs.d.ts",
  "bin": {
    "picjs": "bin/picjs.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/picjs.d.ts",
      "import": "./dist/picjs.js",
      "require": "./dist/picjs.umd.js"
    }
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "test": "node --import=tsx src/test.ts",
    "dev": "vite",
    "cli": "node --import=tsx ./bin/picjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pragdave-devo/picjs.git"
  },
  "keywords": [
    "diagram",
    "svg",
    "pic",
    "pikchr",
    "graphics",
    "mermaid",
    "visualization"
  ],
  "author": "Dave Thomas <labs@strike48.com> (https://labs.strike48.com)",
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "license": "MPL",
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
