# Alphabet Grid (6 columns)
# Demonstrates: string ranges, for-in loops, if/e
# Row 1: A-F

$vowels = [ "A", "E", "I", "O", "U", "Y" ]

$row = fn($start, $end, $fill) {
[
  right
  for $ch in [$start..$end] do {
    if contains($vowels, $ch) {
      $actualFill = Thistle
    } else {
      $actualFill = $fill
    }
    box con $ch fill $actualFill width 0.45 height 0.45
  }
]
}

down
$row("A", "F", "LightBlue")
$row("G", "L", "LightYellow")
$row("M", "R", "LightYellow")
$row("S", "X", "LightYellow")
$row("Y", "Z", "LightBlue")

