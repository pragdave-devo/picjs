# Alphabet Grid (6 columns)
# Demonstrates: string ranges, for-in loops, if/else

# Row 1: A-F
right
for $ch in ["A".."F"] do {
  box con $ch fill LightBlue width 0.45 height 0.45
}

# Row 2: G-L
move to 0, -0.55
for $ch in ["G".."L"] do {
  box con $ch fill LightYellow width 0.45 height 0.45
}

# Row 3: M-R
move to 0, -1.1
for $ch in ["M".."R"] do {
  box con $ch fill LightBlue width 0.45 height 0.45
}

# Row 4: S-X
move to 0, -1.65
for $ch in ["S".."X"] do {
  box con $ch fill LightYellow width 0.45 height 0.45
}

# Row 5: Y-Z
move to 0, -2.2
for $ch in ["Y".."Z"] do {
  box con $ch fill LightBlue width 0.45 height 0.45
}
