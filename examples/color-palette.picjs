# Color Palette Generator
# Demonstrates: for-in loops, range syntax, rgb() function

# Warm colors row (using HSL hues 0-60)
"Warm" rjust
move right 0.3
for h in [0, 15, 30, 45, 60] do {
  box fill hsl(h, 80, 60) width 0.6 height 0.5
  move right 0.1
}

# Cool colors row (using HSL hues 180-270)
move to 0, -0.8
"Cool" rjust
move right 0.3
for h in [180, 200, 220, 250, 280] do {
  box fill hsl(h, 70, 55) width 0.6 height 0.5
  move right 0.1
}

# Nature colors row (greens and browns)
move to 0, -1.6
"Nature" rjust
move right 0.3
for h in [120, 90, 60, 30, 20] do {
  box fill hsl(h, 50, 40) width 0.6 height 0.5
  move right 0.1
}

# Grayscale using numeric range
move to 0, -2.4
"Grays" rjust
move right 0.3
for i in [1..6] do {
  $gray = i * 40
  box fill rgb($gray, $gray, $gray) width 0.6 height 0.5
  move right 0.1
}

# Rainbow using OKLCH (perceptually uniform)
move to 0, -3.2
"Rainbow" rjust
move right 0.3
for h in [0, 45, 90, 135, 180, 225, 270, 315] do {
  box fill oklch(70, 0.15, h) width 0.4 height 0.5
  move right 0.05
}
