// Line labels demo: positioning along paths



// Single label - centered (default 50%)
line -> from (1,1) to (1.8,2) "centered"

// Label at specific position along line
line -> from (2,2) to (3,1) "25%" at 25% above

// Labels at start and end
line -> from (1,.7) to (3,0) "start" at 0% above "end" at 100% above

// Two labels - above and below (default when no position specified)
line -> from (1.5,.8) to (4,.8) "top" "bottom"

Arc from (1,4) to (3,4) "above" above

// Arc with label inside at 50%
Arc from (1,4.5) to (3,4.5) "below" below

// Arc label at specific percent
Arc from (3.5,5) to (4.50,6) "25% outside" at 25% outside

// Multiple arc labels at different positions
Arc from (1,7) to (4,6) "start" at 10% outside "mid" at 50% outside "end" at 90% outside

