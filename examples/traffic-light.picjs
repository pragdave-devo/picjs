# Traffic Light States
# Demonstrates: for-in loops, case expressions

$states = ["stop", "caution", "go"]

for $state in $states do {
  # Housing
  box width 0.6 height 1.8 rad 0.1 fill DarkSlateGray

  # Red light
  case $state {
    "stop" => { circle rad 0.2 fill Red at last box.n - (0, 0.3) }
    else => { circle rad 0.2 fill DarkRed at last box.n - (0, 0.3) }
  }

  # Yellow light
  case $state {
    "caution" => { circle rad 0.2 fill Yellow at last box.c }
    else => { circle rad 0.2 fill Olive at last box.c }
  }

  # Green light
  case $state {
    "go" => { circle rad 0.2 fill LimeGreen at last box.s + (0, 0.3) }
    else => { circle rad 0.2 fill DarkGreen at last box.s + (0, 0.3) }
  }

  # Label using containing attribute
  text con $state at last box.s - (0, 0.25)

  move right 0.8
}
