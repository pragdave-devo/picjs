Line.stroke = Box.fill

box_around = grp => {
  box at grp             behind grp
       wid grp.wid*1.1   ht grp.ht*1.1
       fill ~beige       stroke ~lightgrey
}

pipeline = Group {
  Face s
  Label "Internal Pipeline" .h4 fill ~green
  Gap .2
  self.batch_writer = box wid 150% ht 60% "Batch Writer"
  -> ("post" fill ~darkolivegreen)  ("commit" fill ~darkolivegreen)
  self.trigger_evaluation = box same "Trigger\nEvaluation" fill ~darkolivegreen
  -> ("Trigger" fill ~darkolivegreen)  ("Fired" fill ~darkolivegreen)
  self.trigger_bridge = box same "Trigger\nBridge"
}

box_around(pipeline)

database = circle "Database" with .e at pipeline.batch_writer.w - ( 0.5, 0)

services = Group {
  Face s
  Label "External API" .h4 fill ~green
  Gap .2
  self.get_put_tuple = box wid 150% ht 60%  "Get/Put Tuple"
  line <-> ("Validate" fill ~darkolivegreen)  above
  box "Schemas" same

  Gap 0
  line -> len .5 stroke ~black rot 90 dashed thick .02

  self.playbooks = box wid 150% ht 60% fill ~darkolivegreen "Playbooks"
  Gap  0.2
  self.agents = box same "Agents"
} with .nw at pipeline.ne + (1,0)

Line  -> from pipeline.batch_writer    to database
Line  -> from services.get_put_tuple.w to pipeline.batch_writer.e
Line <-> from services.playbooks.w     to pipeline.trigger_evaluation.e smooth
Line <-> from services.agents          to pipeline.trigger_bridge

box_around(services)
