// A simple shape, drawn repetitively
// try changing this number:
petals = 17

start_color = oklch(70%, .3, 0)

petal = (color) => {
  4.times(=> {
    Arc stroke color
    Arc ccw stroke color.spin(10)
    Arc stroke color.spin(20)
  })
}

petals.times(n => {
  Face 360/petals*n     // 0°, 45°, 90° ...
  petal(start_color.spin(n*30))
})