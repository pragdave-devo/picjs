
spin = 4
circles_per_spin = 50
total_twist = spin * 2 * PI
circle_count = spin * circles_per_spin

color_factor = 255/total_twist
turn = (i) => {
  circle at (7*sin(i*37), 9*cos(i*23))
         radius i
         fill   oklch(60%, 0.25, i*color_factor)
         stroke oklch(5%, 0.2, i*color_factor)
}
[total_twist..0].steps(circle_count, turn)

