 // The standard circular flow of the economy
Palette.current = "sunset"


Box.rx = Box.ry = 0.1
Box.fill  = ~b5 //oklch(.95, 0,    0)
blackish  = oklch(0.6, 0,    0)
blueish   = ~b1 //oklch(.6,  .4,   200)
greenish  = ~b2 //oklch(.6,  .4,   150)
orangeish = ~b3 //oklch(0.9, 0.3,  72)
reddish   = ~b4 //oklch(0.6, 0.35, 40)

// horizontal and vertical offsets for lines meeting
// the sides of boxes

Box.width = 160%
Box.height = 100%

ho = ( Box.width/4, 0)
vo = (0, Box.height/4)

spacer = => box fill ~none stroke ~none
// The players. The layout is a 4x5 grid, but the only entries are in column 2 and row three. There's
// a hole where they intersect.

col = Group {
  Face south
  self.government = box "Government"
                    Gap
  self.households = box "Households"
                    Gap
  self.center     = spacer()
                    Gap
  self.firms      = box "Firms"
                    Gap
  self.row        = box "Rest of" "World"
}

row =  Group {
                   Face east
  self.markets   = box "Markets for" "goods and" "services"
                   Gap
  self.center    = spacer()
                   Gap
  self.factor    = box "Factor" "markets"
                   Gap
  self.fm        = box "Financial" "markets"
} with self.center at col.center

Line.rx = .2
Line.thickness = .2

line ->
  from col.households.e - vo
  then east until even with row.fm.n - ho
  then south until even with row.fm.n
  stroke blueish "Private savings" at 40% above


line ->  
  from col.firms.e - vo 
   then east until even with row.factor.s  
   then south until even with row.factor.s
   stroke orangeish "Wages, profit,\ninterest" at 30% above

line <-  
  from col.firms.e + vo 
   then east until even with row.fm.s - ho  
   then north until even with row.fm.s 
   stroke orangeish "Borrowing and stock issues by firms" below at 40%

line -> 
  from col.firms.w - vo
   then west until even with row.markets.s + ho 
   then north until even with  row.markets.s
   stroke orangeish "Investment\nspending" above at 20% 

line <- 
  from col.firms.w + vo
   then west until even with row.markets.s 
   then north until even with row.markets.s
   stroke orangeish "GDP" below at 30%

line <-> 
  from col.row.w  
   then west until even with row.markets.s - ho
   then north until even with row.markets.s 
   stroke reddish  "Imports/Exports" at 25% above

// "until even with" can be written as just "until", so..

line <-> 
  from col.row.e
   then east  until row.fm.s + ho
   then north until row.fm.s 
   stroke reddish "Foreign lending/stock sales" at 30%
                  "Foreign borrowing/stock purchases" at 30%


line <- 
   from col.households.e + vo
   then east until row.factor.n 
   then south until row.factor.n
   stroke blueish "\nWages, profit,\n interest" at 30% below

l = line ->
   from col.government.s + ho
   to col.households.n + ho
   stroke blueish 
   Label "Govt. transfers" at l.c + (.7,-.2)

l = line <- 
  from col.government.s - ho
  to col.households.n - ho
  stroke greenish
  Label "Taxes" at l.c - (.4,-.2)

 line ->
    from col.households.w 
    then west  until row.markets.n + ho
    then south until row.markets.n
    stroke blueish "Consumer Spending" above at 25% 

line -> 
   from col.government.w
   then west  until even with row.markets.n - ho
   then south until even with row.markets.n
   stroke greenish "Government purchases" at 20% "of goods and services" at 20%
line -> 
   from row.fm.n + ho
   then north  until col.government 
   then to col.government.e
   stroke greenish "Government Borrowing" at 75% above

