# Order State Machine
# Demonstrates: labeled objects, complex arrow routing

# Main flow states
right
Pending: box "pending" fill LightBlue rad 0.1 fit
arrow " place" above
Processing: box "processing" fill LightYellow rad 0.1 fit
arrow " ship" above
Shipped: box "shipped" fill LightCyan rad 0.1 fit
arrow " deliver" above
Delivered: box "delivered" fill LightGreen rad 0.1 fit

# Cancelled state (can come from multiple states)
Cancelled: box "cancelled" fill LightCoral rad 0.1 fit at Processing.s - (0, 1)

# Cancel transitions
arrow from Pending.s to Cancelled.nw " cancel" ljust
arrow from Processing.s to Cancelled.n
arrow from Shipped.s to Cancelled.ne " cancel" rjust

# Retry loop
arrow from Processing.ne up 0.3 then left 0.5 then to Processing.nw "retry" above
