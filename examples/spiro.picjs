# outer ring
outer_radius = 105

# small ring

inner_radius = 30
offset_of_pen = .8  # proportion of distance of pen from center of small disk

# equation of hypotrochoid

for theta from 0 to 2 * $pi step 0.1 do {
    diff = outer_radius - inner_radius

    xp = diff * cos(theta) + offset_of_pen * inner_radius * cos(diff / inner_radius * theta)
    yp = diff * sin(theta) - offset_of_pen * inner_radius * sin(diff / inner_radius * theta)
    line to (xp, yp)
}
